# Staging Database (Supabase pooler string - NEVER production ref exyzbdbitrsidompguda)
DATABASE_URL=postgresql://app_api_user.stagingref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SIM_ALLOW_WRITE=1

# Staging API Configuration (NEVER production URL touchline-api-production-ed283561.up.railway.app)
TOUCHLINE_API_BASE_URL=https://touchline-api-staging.up.railway.app
TOUCHLINE_ADMIN_TOKEN=your_staging_admin_jwt_token

# Simulator HTTP Security Key (used for X-Sim-Key header)
SIM_KEY=your_secret_sim_key

# Test Manager Credentials (for fantasy setup & scoring validation)
TEST_MANAGER_1_USER=manager1@staging.local
TEST_MANAGER_1_PASS=password123
TEST_MANAGER_2_USER=manager2@staging.local
TEST_MANAGER_2_PASS=password123
